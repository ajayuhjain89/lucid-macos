# Public site URL (used for canonical metadata, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://lucid.app

# Optional GitHub repository (defaults to ajayuhjain89/lucid-macos)
NEXT_PUBLIC_GITHUB_REPO=ajayuhjain89/lucid-macos

# Release channel (development | privateBeta | publicBeta | stable)
NEXT_PUBLIC_RELEASE_CHANNEL=publicBeta

# Optional privacy-friendly analytics domain (leave empty to disable analytics)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
